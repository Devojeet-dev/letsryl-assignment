{
  "name": "@bfdp/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API + BullMQ workers for batch financial data processing.",
  "main": "dist/main.api.js",
  "scripts": {
    "dev": "tsx watch src/main.api.ts",
    "dev:combined": "tsx watch src/main.combined.ts",
    "dev:worker": "tsx watch src/main.worker.file.ts",
    "dev:worker:report": "tsx watch src/main.worker.report.ts",
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "start": "node dist/main.api.js",
    "start:combined": "node dist/main.combined.js",
    "start:worker": "node dist/main.worker.file.js",
    "start:worker:report": "node dist/main.worker.report.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bullmq": "^5.28.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "mongoose": "^8.8.1",
    "mongodb": "^6.10.0",
    "multer": "^2.0.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
