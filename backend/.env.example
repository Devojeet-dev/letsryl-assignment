# ---------------------------------------------------------------------------
# Backend (API + workers) runtime configuration for local development.
#
#   cp backend/.env.example backend/.env
#
# `.env` is git-ignored — put real credentials there, never here. The file is
# discovered automatically whether the process starts in backend/ or at the repository root;
# override with ENV_FILE=/abs/path.
#
# Every value below is parsed once at boot by `envSchema`.
# A blank value means "not configured" for optional keys; required keys abort
# start-up with a field-level message (never echoing the value).
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
SERVICE_VERSION=0.1.0
LOG_LEVEL=info

# --- Infrastructure (required) ----------------------------------------------
# `docker compose up -d mongo redis` publishes both on localhost.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=bfdp
REDIS_URL=redis://127.0.0.1:6379

# --- Authentication ---------------------------------------------------------
# Option A — demo reviewer session (POST /api/v1/auth/demo-session):
# no identity provider required. Disable for anything shared or public.
DEMO_AUTH_ENABLED=true
# Required for demo sessions and Google ID tokens. Minimum 32 characters.
APP_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0001
APP_JWT_TTL_SECONDS=3600

# Option B — Supabase access tokens (verified against the project's JWKS):
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# Option C — Google ID token audiences accepted by POST /auth/session
# (comma separated, e.g. 1234-abc.apps.googleusercontent.com):
GOOGLE_CLIENT_IDS=

# Origins allowed to call the API from a browser (comma separated).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# --- Storage ----------------------------------------------------------------
# GridFS bucket names; keep the defaults unless you have a reason to change them.
UPLOAD_BUCKET=uploads
REPORT_BUCKET=reports
# How long a generated workbook is served from GridFS before regeneration.
REPORT_CACHE_TTL_SECONDS=86400

# --- Queue and rate limiting ------------------------------------------------
# Jobs a single worker processes in parallel; raise with more CPU and I/O headroom.
QUEUE_CONCURRENCY=2
# Refuse uploads with 503 QUEUE_UNAVAILABLE above this many waiting+active+delayed jobs.
QUEUE_MAX_DEPTH=5000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
