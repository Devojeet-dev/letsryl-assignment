# ---------------------------------------------------------------------------
# Copy to `.env` (never commit `.env`). Every value below has a working local
# default in docker-compose.yml, so the file is optional for `docker compose up`.
#
# This file configures the Docker stack only. Running the apps from source
# (`npm run dev`) reads apps/backend/.env and apps/frontend/.env instead — see
# the .env.example file in each of those directories.
# ---------------------------------------------------------------------------

# Core
NODE_ENV=production
LOG_LEVEL=info
SERVICE_VERSION=0.1.0
API_PORT=4000
WEB_PORT=5173

# Datastores (compose-only; local dev points these at localhost instead)
MONGODB_DB=bfdp
# MONGODB_URI=mongodb://localhost:27017/bfdp
# REDIS_URL=redis://localhost:6379

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Demo login (POST /api/v1/auth/demo-session). Convenient for review; disable
# for any shared/public deployment.
DEMO_AUTH_ENABLED=true

# Required when DEMO_AUTH_ENABLED=true or when using Google ID tokens.
# Must be at least 32 characters. Rotate for anything beyond local review.
APP_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0001
APP_JWT_TTL_SECONDS=3600

# Supabase (server-side verification of Supabase access tokens)
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# Google ID token audiences accepted by POST /auth/session (comma separated)
GOOGLE_CLIENT_IDS=

# Supabase SPA credentials (baked into the frontend at build time)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Processing / storage
# ---------------------------------------------------------------------------
UPLOAD_BUCKET=uploads
REPORT_BUCKET=reports
REPORT_CACHE_TTL_SECONDS=86400

QUEUE_CONCURRENCY=2
QUEUE_MAX_DEPTH=5000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
