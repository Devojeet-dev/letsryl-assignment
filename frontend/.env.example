# ---------------------------------------------------------------------------
# Frontend (SPA) build-time configuration.
#
#   cp apps/frontend/.env.example apps/frontend/.env
#
# Vite reads this file at dev-server start and at `npm run build`; every value
# is inlined into the bundle, so nothing here may be a secret. Restart the dev
# server after editing.
# ---------------------------------------------------------------------------

# API origin only — no `/api` and no `/api/v1`. The SPA appends the versioned
# prefix itself. Leave it out to fall back to http://localhost:4000.
VITE_API_URL=http://localhost:4000

# Optional: enables Supabase email/password sign-in in the login page.
# Leave both blank to use "Continue as demo reviewer" (requires
# DEMO_AUTH_ENABLED=true and a matching APP_JWT_SECRET in apps/backend/.env).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
